{
  "name": "impactlia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "parse": "tsc -p parser/tsconfig.json && node \"$PWD\"/node_modules/.cache/impactlia-parser/cli.js",
    "check:graph": "tsc -p lib/graph/checks/tsconfig.json && node --test \"$PWD\"/node_modules/.cache/impactlia-graph-checks/checks/graph.test.js",
    "check:adapters": "tsc -p parser/checks/tsconfig.json && node --test \"$PWD\"/node_modules/.cache/impactlia-adapter-checks/checks/adapters.test.js \"$PWD\"/node_modules/.cache/impactlia-adapter-checks/checks/python.test.js \"$PWD\"/node_modules/.cache/impactlia-adapter-checks/checks/languages.test.js \"$PWD\"/node_modules/.cache/impactlia-adapter-checks/checks/overlay.test.js",
    "check:ingestion": "tsc -p lib/ingestion/checks/tsconfig.json && node --test \"$PWD\"/node_modules/.cache/impactlia-ingestion-checks/lib/ingestion/checks/ingestion.test.js \"$PWD\"/node_modules/.cache/impactlia-ingestion-checks/lib/ingestion/checks/selective.test.js",
    "check:ai": "tsc -p lib/ai/checks/tsconfig.json && node --test \"$PWD\"/node_modules/.cache/impactlia-ai-checks/lib/ai/checks/ai.test.js",
    "check:impact": "tsc -p lib/impact/checks/tsconfig.json && node --test \"$PWD\"/node_modules/.cache/impactlia-impact-checks/lib/impact/checks/impact.test.js \"$PWD\"/node_modules/.cache/impactlia-impact-checks/lib/impact/checks/code-issues.test.js \"$PWD\"/node_modules/.cache/impactlia-impact-checks/lib/impact/checks/tests.test.js \"$PWD\"/node_modules/.cache/impactlia-impact-checks/lib/impact/checks/score.test.js \"$PWD\"/node_modules/.cache/impactlia-impact-checks/lib/impact/checks/python.test.js \"$PWD\"/node_modules/.cache/impactlia-impact-checks/lib/impact/checks/languages.test.js",
    "check:automation": "tsc -p lib/automation/checks/tsconfig.json && node --test \"$PWD\"/node_modules/.cache/impactlia-automation-checks/lib/automation/checks/automation.test.js",
    "check:onboarding": "tsc -p lib/onboarding/checks/tsconfig.json && node --test \"$PWD\"/node_modules/.cache/impactlia-onboarding-checks/lib/onboarding/checks/onboarding.test.js",
    "check:database": "sh supabase/tests/run.sh"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.11",
    "@supabase/supabase-js": "^2.117.3",
    "@xyflow/react": "^12.12.0",
    "langsmith": "^0.10.11",
    "next": "16.4.2",
    "openai": "^7.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "typescript": "^5",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4"
  },
  "packageManager": "pnpm@12.10.1"
}
